HOSTPIN_LISTEN=0.0.0.0:8080
HOSTPIN_PUBLIC_URL=http://localhost:8080
# Optional self-hosted Agent artifact directory.
# HOSTPIN_AGENT_RELEASE_BASE=https://monitor.example.com/downloads
HOSTPIN_DATA_DIR=./data
# SQLite is the default. These two values may be omitted unless overriding it.
HOSTPIN_DB_DRIVER=sqlite
HOSTPIN_DB_DSN=./data/hostpin.db
HOSTPIN_LOG_LEVEL=info

# Required for PostgreSQL mode.
# HOSTPIN_DB_DRIVER=postgres
# HOSTPIN_DB_DSN=postgres://hostpin:hostpin@postgres:5432/hostpin?sslmode=disable

# Optional: base64-encoded 32-byte key. If omitted, data/master.key is created.
# HOSTPIN_MASTER_KEY=

# Comma-separated proxy CIDRs whose forwarding headers may be trusted.
# HOSTPIN_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# HOSTPIN_ALLOWED_ORIGINS=https://monitor.example.com
# HOSTPIN_ENROLLMENT_CIDRS=10.0.0.0/8,192.168.0.0/16
# High risk: permit a public_url using plain HTTP on a public address.
# HOSTPIN_ALLOW_INSECURE_HTTP=false

# Optional runtime and location-provider overrides.
# HOSTPIN_GEOIP_ENABLED=true
# HOSTPIN_GEOIP_PROVIDER=https://ipwho.is/{ip}
# HOSTPIN_GEOIP_TIMEOUT=4s
# HOSTPIN_GEOIP_CACHE_TTL=720h
# HOSTPIN_PERSIST_QUEUE_SIZE=10000
# HOSTPIN_OFFLINE_AFTER=90s
# HOSTPIN_SHUTDOWN_TIMEOUT=15s
